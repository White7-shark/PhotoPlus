{
  "name": "photoplus",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:engine": "cmake -S native/engine -B native/engine/build -DPP_ENGINE_BUILD_TESTS=ON -DPP_ENGINE_SANITIZE=ON -DCMAKE_BUILD_TYPE=Debug && cmake --build native/engine/build -j && ./native/engine/build/photoplus_engine_tests",
    "test:android": "cd android && ./gradlew :app:testDebugUnitTest :app:lintDebug",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:engine",
    "postinstall": "patch-package",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"scripts/*.mjs\""
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "^15.16.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "sql.js": "^1.15.2",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=11.20.0"
  },
  "codegenConfig": {
    "name": "PhotoPlusSpecs",
    "type": "all",
    "jsSrcsDir": "src/native/specs",
    "android": {
      "javaPackageName": "com.photoplus.specs"
    }
  },
  "overrides": {
    "babel-jest": "30.5.2",
    "test-exclude": "8.0.0"
  },
  "allowScripts": {
    "@parcel/watcher": false
  }
}
